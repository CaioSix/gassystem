# Supabase (Crie um projeto gratuito em https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp da Distribuidora (Aceita os 4 números separados por vírgula! O primeiro é o número principal do cliente)
# Exemplo com 4 telefones: 5511911111111,5511922222222,5511933333333,5511944444444
NEXT_PUBLIC_STORE_WHATSAPP=5511911111111,5511922222222,5511933333333,5511944444444

# (Opcional) Para a Lambda disparar no WhatsApp dos 4 telefones juntos ao mesmo tempo:
# Formato: numero1:apikey1,numero2:apikey2,numero3:apikey3,numero4:apikey4
WHATSAPP_RECIPIENTS=
CALLMEBOT_API_KEY=
WHATSAPP_WEBHOOK_URL=
