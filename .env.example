# Supabase (Crie um projeto gratuito em https://supabase.com)
# Se não preenchido em ambiente de desenvolvimento, o sistema usa um banco local (.local-orders.json) automaticamente para testes!
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp da Distribuidora (Apenas números com DDI + DDD, ex: 5511999999999)
NEXT_PUBLIC_STORE_WHATSAPP=5511999999999

# Senha simples para proteger a tela do dono (/admin) - padrão: 1234
ADMIN_PIN=1234
