# Supabase (Crie um projeto gratuito em https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp da Distribuidora (Apenas números com DDI + DDD, ex: 5511999999999)
NEXT_PUBLIC_STORE_WHATSAPP=5511999999999

# (Opcional) Notificação automática em segundo plano pela Lambda para o WhatsApp do dono:
# Opção A (100% Grátis): CallMeBot API Key (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_API_KEY=
# Opção B: Webhook próprio (Evolution API, Z-API, n8n, Meta Cloud API)
WHATSAPP_WEBHOOK_URL=
